<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<suite name="Main group suite">
    <test name="Smoke">
        <groups>
            <define name="Group 1">
                <include name="regress">
                </include>
            </define>
            <define name="Group 2">
                <include name="smoke">
                </include>
            </define>
            <define name="Group 3">
                <include name="smoke"/>
                <include name="regress">
                </include>
            </define>
            <run>
                <include name="Group 1"/>
            </run>
        </groups>
        <classes>
            <class name="GroupsTest">
            </class>
        </classes>
    </test>
</suite>